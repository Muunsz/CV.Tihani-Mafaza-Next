  usage_count         Int?      @default(0)
  usage_per_customer  Int?      @default(1)
  valid_from          DateTime  @db.Timestamp(6)
  valid_until         DateTime  @db.Timestamp(6)
  is_active           Boolean?  @default(true)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)

  @@index([code], map: "idx_promotions_code")
  @@index([is_active], map: "idx_promotions_is_active")
}

model quotations {
  id               Int       @id @default(autoincrement())
  quotation_number String    @unique @db.VarChar(50)
  user_id          Int?
  client_name      String?   @db.VarChar(255)
  client_email     String?   @db.VarChar(255)
